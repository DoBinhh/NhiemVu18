# =========================================================
#  Comment Collector · Backend .env
#  Copy file này thành .env rồi điền key thật
# =========================================================

# ---------- YouTube Data API v3 ----------
# 1. Vào https://console.cloud.google.com/apis/credentials
#    → "Create credentials" → "API key" → copy
# 2. Vào https://console.cloud.google.com/apis/library/youtube.googleapis.com
#    → bật "YouTube Data API v3"
#
# Quota miễn phí: 10.000 units / ngày
#   - search.list        = 100 units / lần
#   - commentThreads.list= 1   unit  / lần
#   - videos.list        = 1   unit  / lần
#
# → 1 lần gọi /api/collect ≈ 150–200 units
#    => ~40–50 requests/ngày nếu dùng free tier
YOUTUBE_API_KEY=AIzaSyDNbA7EgMSwMDWkCtTxYPVsdssqLpfv-gA

# ---------- Server ----------
APP_HOST=0.0.0.0
APP_PORT=8000

# Danh sách origin được phép gọi (cách nhau dấu phẩy).
# Để "*" khi dev với file frontend mở trực tiếp.
CORS_ORIGINS=*